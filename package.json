{
  "name": "tokentrail",
  "version": "0.1.0",
  "description": "A local ledger and trail-map for Claude Code spend.",
  "type": "module",
  "bin": {
    "tokentrail": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "tokentrail": "tsx src/index.ts",
    "test": "node --import tsx --test $(find tests -name '*.test.ts')",
    "test:watch": "node --import tsx --test --watch $(find tests -name '*.test.ts')"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "@octokit/rest": "^21.0.2",
    "better-sqlite3": "^11.5.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
