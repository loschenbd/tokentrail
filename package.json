{
  "name": "tokentrail",
  "version": "0.1.0",
  "description": "A local ledger and trail-map for Claude Code spend.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loschenbd/tokentrail.git"
  },
  "homepage": "https://github.com/loschenbd/tokentrail#readme",
  "bugs": {
    "url": "https://github.com/loschenbd/tokentrail/issues"
  },
  "type": "module",
  "bin": {
    "tokentrail": "./dist/src/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build:mascot": "tsx src/mascot/build-frames.ts",
    "build": "npm run build:mascot && tsc && node -e \"const fs=require('fs');fs.mkdirSync('dist/src/mascot',{recursive:true});fs.copyFileSync('src/mascot/frames.json','dist/src/mascot/frames.json');\"",
    "start": "node dist/index.js",
    "tokentrail": "tsx src/index.ts",
    "test": "node --import tsx --test $(find tests -name '*.test.ts')",
    "test:watch": "node --import tsx --test --watch $(find tests -name '*.test.ts')",
    "bake:readme": "tsx scripts/bake-readme-mascot.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "@octokit/rest": "^21.0.2",
    "better-sqlite3": "^11.5.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.29.1",
    "open": "^10.2.0",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "uplot": "^1.6.32"
  }
}
